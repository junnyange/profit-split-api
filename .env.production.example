# 배포 서버용 환경변수 목록. 이 파일을 .env.production으로 복사해서 값을 채운다.
#   cp .env.production.example .env.production
# .env.production은 .gitignore에 있다. 실제 값은 절대 커밋하지 않는다.

# ── 접속 주소 ──
# 도메인이 있으면 적는다 (예: split.example.com) → Caddy가 HTTPS 인증서를 자동 발급.
# 비워 두면 http://서버IP 로만 동작 (테스트용. 이때는 COOKIE_SECURE=false 필요, README 경고 참고)
DOMAIN=

# ── 앱 ──
# 공용 접속 코드 (필수)
APP_ACCESS_CODE=
# 쿠키 서명 비밀값, 32자 이상 (필수). 생성: openssl rand -hex 32
APP_COOKIE_SECRET=
# 비워 두면 true(HTTPS에서만 쿠키). 도메인 없이 http로 테스트할 때만 false
COOKIE_SECURE=
# true면 확정된 주의 원자재 금액 수정을 막는다 (권장: true)
LOCK_CONFIRMED_WEEKS=
# 빈 DB에 넣을 멤버 이름, 쉼표로 구분, 적은 순서대로 id 1부터 (예: A,B,C,D,E).
# members가 이미 있으면 무시된다. 처음 한 번 넣은 뒤에는 비워 둬도 된다.
SEED_MEMBERS=

# ── DB (mysql 컨테이너가 처음 시작할 때 이 값으로 DB와 사용자를 만든다) ──
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# 앱이 접속할 때 쓰는 값. 위 MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD와 똑같이 적는다
# (DB_HOST, DB_PORT는 docker-compose.prod.yml이 정한다)
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
